# W-LLM-API-01 configuration. Copy values into your own shell or private .env; never commit real keys.
# Offline (default, free): leave REFUND_DRAFTS_PROVIDER=fake. Nothing below is needed.
REFUND_DRAFTS_PROVIDER=fake
# Live (paid): set REFUND_DRAFTS_PROVIDER=openai, a model your account can use, and your key privately.
OPENAI_MODEL=
OPENAI_API_KEY=
# Bounds (seconds / counts). Defaults shown.
REFUND_DRAFTS_ATTEMPT_TIMEOUT_S=20
REFUND_DRAFTS_TOTAL_DEADLINE_S=45
REFUND_DRAFTS_MAX_ATTEMPTS=3
REFUND_DRAFTS_MAX_OUTPUT_TOKENS=400
