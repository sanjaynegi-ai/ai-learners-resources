# Optional n8n editor instance only; copy locally and generate a private encryption key.
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
# Never use this placeholder as a deployed secret.
N8N_ENCRYPTION_KEY=replace-with-private-local-key
# Workflow demonstration uses the public synthetic header synthetic-lab-A, not a real credential.
